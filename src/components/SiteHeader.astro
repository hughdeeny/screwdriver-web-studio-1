---
import TrackedLink from "./TrackedLink.astro";
import { STRATEGY_CALL_HREF, servicePages } from "../data/site";

const LOGIN_HREF = "https://members.screwdrivermarketing.com.au/";
const PHONE_DISPLAY = "0475 624 247";
const PHONE_TEL = "tel:+61475624247";

const navButtonClass =
  "inline-flex min-h-[44px] items-center justify-center gap-2 rounded-none border border-[var(--border)] bg-bg-elevated px-5 py-2.5 text-base font-bold text-cream transition hover:border-accent hover:bg-white";
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-bg-deep">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
    <a href="/" class="font-display text-lg font-bold tracking-tight text-cream sm:text-xl">
      Screwdriver <span class="text-accent">Marketing</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="hidden items-center gap-3 lg:flex" aria-label="Primary">
        <details class="group relative">
          <summary class={`${navButtonClass} cursor-pointer list-none`}>
            Services
            <svg
              class="h-4 w-4 transition group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div
            class="absolute right-0 top-full z-20 mt-2 min-w-[16rem] border border-[var(--border)] bg-bg-elevated p-2 shadow-lg"
          >
            {
              servicePages.map((service) => (
                <a
                  href={`/services/${service.slug}/`}
                  class="block min-h-[44px] px-4 py-3 text-base font-bold text-cream transition hover:bg-bg-deep hover:text-accent"
                >
                  {service.title}
                </a>
              ))
            }
          </div>
        </details>

        <a href={LOGIN_HREF} class={navButtonClass}>Login</a>

        <a href={PHONE_TEL} class={navButtonClass}>{PHONE_DISPLAY}</a>

        <TrackedLink
          href={STRATEGY_CALL_HREF}
          event="cta_click"
          cta="header_book_call"
          class={navButtonClass}
        >
          Book a Demo Call
        </TrackedLink>
      </nav>

      <details class="relative lg:hidden">
        <summary
          class="flex min-h-[44px] cursor-pointer list-none items-center gap-2 rounded-none border border-[var(--border)] bg-bg-elevated px-4 py-2 text-base font-bold text-cream"
        >
          <span class="sr-only">Open menu</span>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"
            ></path>
          </svg>
          Menu
        </summary>
        <div class="absolute right-0 top-full z-20 mt-2 w-64 border border-[var(--border)] bg-bg-elevated p-2 shadow-lg">
          <p class="px-4 py-2 text-xs font-bold uppercase tracking-wide text-muted">Services</p>
          {
            servicePages.map((service) => (
              <a
                href={`/services/${service.slug}/`}
                class="block min-h-[44px] px-4 py-3 text-base font-bold text-cream hover:bg-bg-deep hover:text-accent"
              >
                {service.title}
              </a>
            ))
          }
          <a
            href={LOGIN_HREF}
            class="mt-1 block min-h-[44px] border-t border-[var(--border)] px-4 py-3 text-base font-bold text-cream hover:bg-bg-deep hover:text-accent"
          >
            Login
          </a>
          <a
            href={PHONE_TEL}
            class="block min-h-[44px] px-4 py-3 text-base font-bold text-cream hover:bg-bg-deep hover:text-accent"
          >
            {PHONE_DISPLAY}
          </a>
          <TrackedLink
            href={STRATEGY_CALL_HREF}
            event="cta_click"
            cta="mobile_nav_book_call"
            class="block min-h-[44px] px-4 py-3 text-base font-bold text-cream hover:bg-bg-deep hover:text-accent"
          >
            Book a Demo Call
          </TrackedLink>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
