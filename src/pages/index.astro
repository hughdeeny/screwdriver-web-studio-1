---
import Layout from "../layouts/Layout.astro";
import TrackedLink from "../components/TrackedLink.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { STRATEGY_CALL_HREF, packages } from "../data/site";
---

<Layout>
  <div class="relative overflow-x-hidden">
    <SiteHeader />

    <main id="top">
      <!-- Hero -->
      <section class="relative z-10 px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16" aria-labelledby="hero-heading">
        <div class="mx-auto max-w-6xl">
          <div class="hero-animate grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="flex flex-col gap-5">
              <h1
                id="hero-heading"
                class="font-headline text-4xl font-black leading-[1.08] tracking-tight text-cream sm:text-5xl lg:text-[3.25rem]"
              >
                Marketing that generates revenue
                <span class="mt-4 block text-2xl font-bold sm:text-3xl lg:text-4xl">
                  Call now:{" "}
                  <a href="tel:+61475624247" class="text-accent underline-offset-4 transition hover:underline">
                    0475 624 247
                  </a>
                </span>
              </h1>
              <p class="text-lg leading-relaxed text-muted sm:text-xl">
                We help tradies and service businesses turn Google searches into phone calls, quote requests,
                and booked jobs with a better website, Google Business Profile setup, lead tracking, and practical
                follow-up systems.
              </p>
              <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:flex-wrap">
                <TrackedLink
                  href={STRATEGY_CALL_HREF}
                  event="cta_click"
                  cta="hero_book_demo_call"
                  class="inline-flex min-h-[52px] items-center justify-center rounded-none bg-accent px-8 text-base font-bold text-white shadow-md shadow-accent/15 transition hover:bg-accent-glow"
                >
                  Book a Demo Call
                </TrackedLink>
              </div>
              <p class="text-sm text-muted">
                For tradies, gardeners, landscapers, cleaners, clinics, and local service businesses.
              </p>
            </div>
            <div class="mx-auto w-full max-w-md lg:max-w-none">
              <img
                src="/hugh-portrait.png"
                alt="Hugh Heidenreich from Screwdriver Marketing"
                width="768"
                height="1024"
                class="h-auto w-full object-cover object-top"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="relative z-10 scroll-mt-24 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <h2 class="font-headline text-center text-3xl font-bold tracking-tight text-cream sm:text-4xl">
            Simple packages
          </h2>
          <p class="mx-auto mt-3 max-w-2xl text-center text-lg text-muted">
            Start lean, then add tracking, SEO pages, and follow-up systems as the business grows.
          </p>
          <div class="mt-12 grid gap-6 lg:grid-cols-3">
            {
              packages.map((pkg) => (
                <article
                  class:list={[
                    "flex flex-col border bg-bg-elevated p-6 sm:p-8",
                    pkg.recommended ? "border-accent" : "border-[var(--border)]",
                  ]}
                >
                  {
                    pkg.recommended && (
                      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-accent">Recommended</p>
                    )
                  }
                  <h3 class="font-headline text-xl font-bold text-cream">{pkg.name}</h3>
                  <p class="mt-2 text-sm text-muted">{pkg.blurb}</p>
                  <ul class="mt-6 flex-1 space-y-2.5 text-sm text-cream/90">
                    {
                      pkg.outcomes.map((o) => (
                        <li class="flex gap-2">
                          <span class="text-accent" aria-hidden="true">
                            ✓
                          </span>
                          {o}
                        </li>
                      ))
                    }
                  </ul>
                  <TrackedLink
                    href={STRATEGY_CALL_HREF}
                    event="quote_click"
                    pkg={pkg.name}
                    class:list={[
                      "mt-6 inline-flex min-h-[48px] w-full items-center justify-center rounded-none text-sm font-semibold transition",
                      pkg.recommended
                        ? "bg-accent text-white hover:bg-accent-glow"
                        : "border border-[var(--border)] text-cream hover:border-accent hover:bg-bg-deep",
                    ]}
                  >
                    Discuss this option
                  </TrackedLink>
                </article>
              ))
            }
          </div>
          <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted">
            Pricing depends on scope. A simple starting option is available for businesses that want to get moving
            quickly.
          </p>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
          <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
            <iframe
              src="https://links.screwdrivermarketing.com.au/widget/form/eEBGmwDUUSauLVfx0aPz"
              style="width:100%;height:723px;border:none;border-radius:0px"
              id="inline-eEBGmwDUUSauLVfx0aPz"
              data-layout="{'id':'INLINE'}"
              data-trigger-type="alwaysShow"
              data-trigger-value=""
              data-activation-type="alwaysActivated"
              data-activation-value=""
              data-deactivation-type="neverDeactivate"
              data-deactivation-value=""
              data-form-name="3.0 Contact Form"
              data-height="723"
              data-layout-iframe-id="inline-eEBGmwDUUSauLVfx0aPz"
              data-form-id="eEBGmwDUUSauLVfx0aPz"
              title="3.0 Contact Form"
            >
            </iframe>
            <script is:inline src="https://links.screwdrivermarketing.com.au/js/form_embed.js"></script>
          </div>
          <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream sm:text-4xl">About me</h2>
            <p class="mt-5 font-headline text-2xl font-bold tracking-tight text-cream">Hugh Heidenreich</p>
            <p class="mt-3 text-lg leading-relaxed text-muted">
              Business student at Adelaide Uni with coursework in Computer Science, IT and a focus on Technology.
            </p>
          </div>
        </div>
      </section>

      <!-- Reviews -->
      <section id="reviews" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto max-w-4xl">
          <h2 class="font-headline text-center text-3xl font-bold tracking-tight text-cream sm:text-4xl">
            What our customers say
          </h2>
          <div class="mt-8 w-full">
            <iframe
              class="lc_reviews_widget"
              src="https://reputationhub.site/reputation/widgets/review_widget/bmGaavXSqDZZy5mf1DCh"
              frameborder="0"
              scrolling="no"
              style="min-width:100%;width:100%"
              title="What our customers say"
            >
            </iframe>
            <script
              is:inline
              type="text/javascript"
              src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
