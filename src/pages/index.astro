---
import Layout from "../layouts/Layout.astro";
import TrackedLink from "../components/TrackedLink.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BrandLogoCarousel from "../components/BrandLogoCarousel.astro";
import { STRATEGY_CALL_HREF, caseStudies, servicePages } from "../data/site";

const featuredCaseStudies = caseStudies.slice(0, 2);
---

<Layout>
  <div class="relative overflow-x-hidden">
    <SiteHeader />

    <main id="top">
      <!-- Hero -->
      <section class="relative z-10 px-5 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-16" aria-labelledby="hero-heading">
        <div class="mx-auto max-w-6xl">
          <div class="hero-animate grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="flex flex-col gap-5">
              <h1
                id="hero-heading"
                class="font-headline text-4xl font-black leading-[1.08] tracking-tight text-cream sm:text-5xl lg:text-[3.25rem]"
              >
                Website Design &amp; Marketing Systems For Construction and trades businesses
              </h1>
              <p class="text-lg leading-relaxed text-muted sm:text-xl">
                It&apos;s not rocket science. Fix the holes in your website and Google page and you&apos;ll stop losing
                customers to the tradie that can get to the phone.
              </p>
              <div class="flex flex-col gap-3 pt-1 sm:flex-row sm:flex-wrap">
                <TrackedLink
                  href={STRATEGY_CALL_HREF}
                  event="cta_click"
                  cta="hero_book_demo_call"
                  class="inline-flex min-h-[52px] items-center justify-center rounded-none bg-accent px-8 text-base font-bold text-white shadow-md shadow-accent/15 transition hover:bg-accent-glow"
                >
                  Book a Demo Call
                </TrackedLink>
              </div>
              <p class="text-sm text-muted">
                For tradies, gardeners, landscapers, cleaners, clinics, and local service businesses.
              </p>
            </div>
            <div class="mx-auto w-full max-w-md lg:max-w-none">
              <img
                src="/hugh-portrait.png"
                alt="Hugh Heidenreich from Screwdriver Marketing"
                width="768"
                height="1024"
                class="h-auto w-full object-cover object-top"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </section>

      <BrandLogoCarousel />

      <!-- Services -->
      <section id="services" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-3xl">
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream sm:text-4xl">Services</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">
              Websites, Google reputation, automations, and custom tools — built for construction and trades businesses
              that need clearer paths from search to enquiry.
            </p>
          </div>
          <div class="mt-10 grid gap-6 sm:grid-cols-2">
            {
              servicePages.map((service) => (
                <a
                  href={`/services/${service.slug}/`}
                  class="group border border-[var(--border)] bg-bg-elevated p-6 transition hover:border-accent sm:p-8"
                >
                  <h3 class="font-headline text-xl font-bold text-cream group-hover:text-accent">{service.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-muted">{service.summary}</p>
                </a>
              ))
            }
          </div>
          <div class="mt-8">
            <a
              href="/pricing/"
              class="inline-flex min-h-[48px] items-center justify-center rounded-none border border-[var(--border)] px-6 text-sm font-semibold text-cream transition hover:border-accent"
            >
              See website &amp; reputation packages
            </a>
          </div>
        </div>
      </section>

      <!-- Case studies -->
      <section id="case-studies" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto max-w-6xl">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div class="max-w-2xl">
              <h2 class="font-headline text-3xl font-bold tracking-tight text-cream sm:text-4xl">Case studies</h2>
              <p class="mt-4 text-lg leading-relaxed text-muted">
                Results from local operators using reputation systems and a stronger Google presence.
              </p>
            </div>
            <a
              href="/case-studies/"
              class="text-sm font-semibold text-accent underline-offset-2 transition hover:underline"
            >
              View all case studies
            </a>
          </div>

          <div class="mt-10 grid gap-6 lg:grid-cols-2">
            {
              featuredCaseStudies.map((study) => (
                <article class="flex flex-col border border-[var(--border)] bg-bg-elevated p-6 sm:p-8">
                  <p class="text-sm font-semibold uppercase tracking-wide text-accent">{study.category}</p>
                  <h3 class="font-headline mt-2 text-2xl font-bold text-cream">{study.client}</h3>
                  <p class="mt-2 text-lg font-semibold text-cream/90">{study.headline}</p>
                  <dl class="mt-6 grid grid-cols-3 gap-3">
                    {study.metrics.map((metric) => (
                      <div class="text-center">
                        <dt class="font-headline text-2xl font-black text-accent sm:text-3xl">{metric.value}</dt>
                        <dd class="mt-1 text-xs text-muted sm:text-sm">{metric.label}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="mt-6 flex-1 text-base leading-relaxed text-muted">{study.summary}</p>
                  <a
                    href="/case-studies/"
                    class="mt-6 text-sm font-semibold text-accent underline-offset-2 transition hover:underline"
                  >
                    Read the story
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- About -->
      <section id="about" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
          <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
            <iframe
              src="https://links.screwdrivermarketing.com.au/widget/form/eEBGmwDUUSauLVfx0aPz"
              style="width:100%;height:723px;border:none;border-radius:0px"
              id="inline-eEBGmwDUUSauLVfx0aPz"
              data-layout="{'id':'INLINE'}"
              data-trigger-type="alwaysShow"
              data-trigger-value=""
              data-activation-type="alwaysActivated"
              data-activation-value=""
              data-deactivation-type="neverDeactivate"
              data-deactivation-value=""
              data-form-name="3.0 Contact Form"
              data-height="723"
              data-layout-iframe-id="inline-eEBGmwDUUSauLVfx0aPz"
              data-form-id="eEBGmwDUUSauLVfx0aPz"
              title="3.0 Contact Form"
            >
            </iframe>
            <script is:inline src="https://links.screwdrivermarketing.com.au/js/form_embed.js"></script>
          </div>
          <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream sm:text-4xl">About me</h2>
            <p class="mt-5 font-headline text-2xl font-bold tracking-tight text-cream">Hugh Heidenreich</p>
            <ul class="mt-3 space-y-3 text-lg leading-relaxed text-muted">
              <li class="flex gap-3">
                <span class="mt-1 text-accent" aria-hidden="true">•</span>
                <span>
                  Business student at Adelaide Uni with coursework in Computer Science and IT, including data analysis,
                  programming for engineering, blockchain and cryptocurrency, interface design, data prediction and
                  taming, and unstructured data.
                </span>
              </li>
              <li class="flex gap-3">
                <span class="mt-1 text-accent" aria-hidden="true">•</span>
                <span>
                  Received awards in Entrepreneurial Foundations, and a scholarship to attend the US-based Family
                  Business Analysis case study competition.
                </span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Reviews -->
      <section id="reviews" class="relative z-10 border-t border-[var(--border)] px-5 py-20 sm:px-6 sm:py-24">
        <div class="mx-auto max-w-4xl">
          <h2 class="font-headline text-center text-3xl font-bold tracking-tight text-cream sm:text-4xl">
            What our customers say
          </h2>
          <div class="mt-8 w-full">
            <iframe
              class="lc_reviews_widget"
              src="https://reputationhub.site/reputation/widgets/review_widget/bmGaavXSqDZZy5mf1DCh"
              frameborder="0"
              scrolling="no"
              style="min-width:100%;width:100%"
              title="What our customers say"
            >
            </iframe>
            <script
              is:inline
              type="text/javascript"
              src="https://reputationhub.site/reputation/assets/review-widget.js"></script>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
