---
import Layout from "../../layouts/Layout.astro";
import TrackedLink from "../../components/TrackedLink.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  STRATEGY_CALL_HREF,
  websitePackages,
  websitePlanExtras,
  websiteYearlyBonus,
  reputationPackages,
  reputationIncludes,
  socialMediaAddon,
} from "../../data/site";
---

<Layout
  title="Pricing | Screwdriver Marketing"
  description="Website plans, Google reputation management, and organic social media packages for construction and trades businesses. AUD incl. GST."
>
  <div class="relative overflow-x-hidden">
    <SiteHeader />

    <main id="top">
      <section class="relative z-10 px-5 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16">
        <div class="mx-auto max-w-3xl text-center">
          <h1 class="font-headline text-4xl font-black tracking-tight text-cream sm:text-5xl">Pricing</h1>
          <p class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">
            Website plans, reputation management, and optional social media — choose what fits, then grow from there.
          </p>
          <p class="mt-3 text-sm text-muted">AUD incl. GST. Annual payment upfront: 12 months for the price of 10.</p>
        </div>
      </section>

      <!-- Website plans -->
      <section id="websites" class="relative z-10 border-t border-[var(--border)] px-5 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent">Website plans</p>
            <h2 class="font-headline mt-2 text-3xl font-bold tracking-tight text-cream sm:text-4xl">
              A website that fits. Room to grow.
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">
              Choose a professional online home, connected customer tools, or a complete website and follow-up system.
            </p>
          </div>

          <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-cream/90">
            {
              websitePlanExtras.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="text-accent" aria-hidden="true">
                    ✓
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-2 text-sm text-muted">Included in every website plan.</p>

          <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {
              websitePackages.map((pkg) => (
                <article
                  class:list={[
                    "flex flex-col border bg-bg-elevated p-6 sm:p-8",
                    pkg.recommended ? "border-accent" : "border-[var(--border)]",
                  ]}
                >
                  {pkg.recommended && (
                    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-accent">Recommended</p>
                  )}
                  <h3 class="font-headline text-2xl font-bold text-cream">{pkg.name}</h3>
                  <p class="mt-2 font-headline text-3xl font-black text-accent">{pkg.price}</p>
                  {pkg.priceAlt && <p class="mt-1 text-sm text-muted">{pkg.priceAlt}</p>}
                  <p class="mt-4 text-lg font-semibold text-cream">{pkg.blurb}</p>
                  <p class="mt-3 text-base leading-relaxed text-muted">{pkg.body}</p>
                  <ul class="mt-6 flex-1 space-y-2.5 text-sm text-cream/90">
                    {pkg.outcomes.map((o) => (
                      <li class="flex gap-2">
                        <span class="text-accent" aria-hidden="true">
                          ✓
                        </span>
                        {o}
                      </li>
                    ))}
                  </ul>
                  {pkg.note && <p class="mt-4 text-sm font-medium text-muted">{pkg.note}</p>}
                  <TrackedLink
                    href={STRATEGY_CALL_HREF}
                    event="quote_click"
                    pkg={pkg.name}
                    class:list={[
                      "mt-6 inline-flex min-h-[48px] w-full items-center justify-center rounded-none text-sm font-semibold transition",
                      pkg.recommended
                        ? "bg-accent text-white hover:bg-accent-glow"
                        : "border border-[var(--border)] text-cream hover:border-accent hover:bg-bg-deep",
                    ]}
                  >
                    Discuss this plan
                  </TrackedLink>
                </article>
              ))
            }
          </div>

          <p class="mt-8 max-w-3xl text-sm leading-relaxed text-muted">{websiteYearlyBonus}</p>
        </div>
      </section>

      <!-- Reputation -->
      <section id="reputation" class="relative z-10 border-t border-[var(--border)] px-5 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-wide text-accent">Google reputation management</p>
            <h2 class="font-headline mt-2 text-3xl font-bold tracking-tight text-cream sm:text-4xl">
              Let your good work build your reputation.
            </h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">
              Dedicated review management, with a request allowance to suit the number of customers you serve.
            </p>
          </div>

          <div class="mt-10 grid gap-6 lg:grid-cols-3">
            {
              reputationPackages.map((pkg) => (
                <article
                  class:list={[
                    "flex flex-col border bg-bg-elevated p-6 sm:p-8",
                    pkg.recommended ? "border-accent" : "border-[var(--border)]",
                  ]}
                >
                  {pkg.recommended && (
                    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-accent">Recommended</p>
                  )}
                  <h3 class="font-headline text-2xl font-bold text-cream">{pkg.name}</h3>
                  <p class="mt-2 font-headline text-3xl font-black text-accent">{pkg.price}</p>
                  {pkg.priceAlt && <p class="mt-1 text-sm text-muted">{pkg.priceAlt}</p>}
                  <p class="mt-4 text-lg font-semibold text-cream">{pkg.blurb}</p>
                  <p class="mt-3 text-base leading-relaxed text-muted">{pkg.body}</p>
                  <ul class="mt-6 flex-1 space-y-2.5 text-sm text-cream/90">
                    {pkg.outcomes.map((o) => (
                      <li class="flex gap-2">
                        <span class="text-accent" aria-hidden="true">
                          ✓
                        </span>
                        {o}
                      </li>
                    ))}
                  </ul>
                  <TrackedLink
                    href={STRATEGY_CALL_HREF}
                    event="quote_click"
                    pkg={`Reputation ${pkg.name}`}
                    class:list={[
                      "mt-6 inline-flex min-h-[48px] w-full items-center justify-center rounded-none text-sm font-semibold transition",
                      pkg.recommended
                        ? "bg-accent text-white hover:bg-accent-glow"
                        : "border border-[var(--border)] text-cream hover:border-accent hover:bg-bg-deep",
                    ]}
                  >
                    Discuss this option
                  </TrackedLink>
                </article>
              ))
            }
          </div>

          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              reputationIncludes.map((item) => (
                <div>
                  <h3 class="font-headline text-lg font-bold text-cream">{item.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-6 text-sm text-muted">Request allowances reset monthly.</p>
        </div>
      </section>

      <!-- Social add-on -->
      <section id="social" class="relative z-10 border-t border-[var(--border)] px-5 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-start lg:gap-14">
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide text-accent">Optional add-on</p>
              <h2 class="font-headline mt-2 text-3xl font-bold tracking-tight text-cream sm:text-4xl">
                {socialMediaAddon.name}
              </h2>
              <p class="mt-4 text-lg leading-relaxed text-muted">{socialMediaAddon.body}</p>
              <ul class="mt-8 space-y-3">
                {
                  socialMediaAddon.outcomes.map((o) => (
                    <li class="flex gap-3 text-cream/90">
                      <span class="mt-1 text-accent" aria-hidden="true">
                        ✓
                      </span>
                      <span>{o}</span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-6 text-sm text-muted">{socialMediaAddon.note}</p>
            </div>
            <article class="border border-[var(--border)] bg-bg-elevated p-6 sm:p-8">
              <p class="text-lg font-semibold text-cream">{socialMediaAddon.blurb}</p>
              <p class="mt-3 font-headline text-3xl font-black text-accent">{socialMediaAddon.price}</p>
              <p class="mt-1 text-sm text-muted">{socialMediaAddon.priceAlt}</p>
              <TrackedLink
                href={STRATEGY_CALL_HREF}
                event="quote_click"
                pkg={socialMediaAddon.name}
                class="mt-8 inline-flex min-h-[48px] w-full items-center justify-center rounded-none bg-accent text-sm font-semibold text-white transition hover:bg-accent-glow"
              >
                Discuss this add-on
              </TrackedLink>
            </article>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
