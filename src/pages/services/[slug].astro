---
import Layout from "../../layouts/Layout.astro";
import TrackedLink from "../../components/TrackedLink.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { STRATEGY_CALL_HREF, servicePages, getServiceBySlug } from "../../data/site";

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  throw new Error(`Unknown service slug: ${slug}`);
}

const formId = "eEBGmwDUUSauLVfx0aPz";
const formIframeId = `inline-${formId}-${service.slug}`;
const brandAccent = service.slug === "screwdriver-toolbox" ? "Toolbox" : "Marketing";
const showContactForm = service.slug !== "screwdriver-toolbox";
---

<Layout
  title={`${service.title} | Screwdriver Marketing`}
  description={service.summary}
>
  <div class="relative overflow-x-hidden">
    <SiteHeader brandAccent={brandAccent} />

    <main id="top">
      <section class="relative z-10 px-5 pb-16 pt-12 sm:px-6 sm:pb-20 sm:pt-16">
        <div class="mx-auto max-w-3xl">
          <p class="text-sm font-medium text-muted">
            <span>Services</span>
            <span class="mx-2 text-[var(--border)]" aria-hidden="true">/</span>
            <span>{service.navLabel}</span>
          </p>
          <h1 class="font-headline mt-4 text-4xl font-black tracking-tight text-cream sm:text-5xl">
            {service.headline}
          </h1>
          {
            service.loomEmbedUrl && (
              <div class="relative mt-8 h-0 pb-[56.25%]">
                <iframe
                  src={service.loomEmbedUrl}
                  title={service.headline}
                  allowFullScreen
                  class="absolute left-0 top-0 h-full w-full border-0"
                />
              </div>
            )
          }
          <p class="mt-5 text-lg leading-relaxed text-muted sm:text-xl">{service.summary}</p>
          {
            service.freeApps && service.freeApps.length > 0 && (
              <div class="mt-10">
                <h2 class="font-headline text-2xl font-bold tracking-tight text-cream sm:text-3xl">Free apps</h2>
                <div class="mt-6 flex flex-col gap-10">
                  {service.freeApps.map((app) => (
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                      <a
                        href={app.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex w-fit transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                        aria-label={`${app.name} — ${app.label}`}
                      >
                        {app.iconSrc ? (
                          <img
                            src={app.iconSrc}
                            alt={app.iconAlt ?? `${app.name} icon`}
                            width="160"
                            height="160"
                            class="aspect-square h-40 w-40 rounded-2xl object-contain shadow-lg"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="font-semibold text-accent underline-offset-4 hover:underline">{app.name}</span>
                        )}
                      </a>
                      <div class="flex flex-col gap-3">
                        <p class="font-headline text-lg font-bold text-cream">{app.name}</p>
                        <p class="max-w-sm text-base leading-relaxed text-muted">{app.label}</p>
                        {app.showInstall && (
                          <a
                            href={`${app.href}?install=1`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex min-h-[48px] w-fit items-center justify-center rounded-none border border-[var(--border)] bg-bg-elevated px-5 text-sm font-bold text-cream transition hover:border-accent"
                          >
                            Install for Android
                          </a>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )
          }
          <div class="mt-8">
            <TrackedLink
              href={STRATEGY_CALL_HREF}
              event="cta_click"
              cta={`service_${service.slug}_book_call`}
              class="inline-flex min-h-[52px] items-center justify-center rounded-none bg-accent px-8 text-base font-bold text-white shadow-md shadow-accent/15 transition hover:bg-accent-glow"
            >
              Book a Demo Call
            </TrackedLink>
          </div>
        </div>
      </section>

      <section class="relative z-10 border-t border-[var(--border)] px-5 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream">What this helps with</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">{service.description}</p>
            <ul class="mt-8 space-y-3">
              {
                service.outcomes.map((item) => (
                  <li class="flex gap-3 text-cream/90">
                    <span class="mt-1 text-accent" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream">What&apos;s included</h2>
            <ul class="mt-8 space-y-3">
              {
                service.includes.map((item) => (
                  <li class="border-b border-[var(--border)] pb-3 text-cream/90 last:border-b-0">
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="relative z-10 border-t border-[var(--border)] px-5 py-16 sm:px-6 sm:py-20">
        <div
          class:list={[
            "mx-auto max-w-6xl gap-10 lg:items-start lg:gap-14",
            showContactForm ? "grid lg:grid-cols-2" : "max-w-3xl",
          ]}
        >
          <div>
            <h2 class="font-headline text-3xl font-bold tracking-tight text-cream">Want to talk through fit?</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">
              Book a Demo Call and we&apos;ll look at where {service.navLabel.toLowerCase()} fits your business.
            </p>
            <TrackedLink
              href={STRATEGY_CALL_HREF}
              event="cta_click"
              cta={`service_${service.slug}_bottom_book_call`}
              class="mt-8 inline-flex min-h-[52px] items-center justify-center rounded-none bg-accent px-8 text-base font-bold text-white transition hover:bg-accent-glow"
            >
              Book a Demo Call
            </TrackedLink>
          </div>
          {
            showContactForm && (
              <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
                <iframe
                  src={`https://links.screwdrivermarketing.com.au/widget/form/${formId}`}
                  style="width:100%;height:723px;border:none;border-radius:0px"
                  id={formIframeId}
                  data-layout="{'id':'INLINE'}"
                  data-trigger-type="alwaysShow"
                  data-trigger-value=""
                  data-activation-type="alwaysActivated"
                  data-activation-value=""
                  data-deactivation-type="neverDeactivate"
                  data-deactivation-value=""
                  data-form-name="3.0 Contact Form"
                  data-height="723"
                  data-layout-iframe-id={formIframeId}
                  data-form-id={formId}
                  title="Quote form"
                >
                </iframe>
                <script is:inline src="https://links.screwdrivermarketing.com.au/js/form_embed.js"></script>
              </div>
            )
          }
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</Layout>
